{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Yukino",
  "scopeName": "source.yukino",
  "patterns": [
    {
      "include": "#strings"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#macro-declarations"
    },
    {
      "include": "#function-declarations"
    },
    {
      "include": "#lambda-expressions"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#keywords-declaration"
    },
    {
      "include": "#keywords-control"
    },
    {
      "include": "#keywords-other"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#macro-calls"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#struct-fields"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.yukino",
          "match": "//.*$"
        },
        {
          "name": "comment.block.yukino",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.compiler.yukino",
          "begin": "(#!?\\[|!#\\[)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.attribute.yukino"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.yukino"
            }
          },
          "patterns": [
            {
              "begin": "\\[",
              "end": "\\]",
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#constants"
                },
                {
                  "match": ",",
                  "name": "punctuation.separator.yukino"
                }
              ]
            },
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "name": "keyword.operator.yukino",
              "match": "[!=]"
            },
            {
              "name": "punctuation.separator.yukino",
              "match": "::|,"
            },
            {
              "name": "variable.parameter.yukino",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*=)"
            },
            {
              "name": "entity.other.attribute-name.yukino",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        },
        {
          "name": "meta.attribute.cabi.yukino",
          "begin": "(?<=^\\s*(?:(?:public|locked|static)\\s+)?)\\|(?=[a-zA-Z_][a-zA-Z0-9_]*(?:\\s*[,=\\(]|\\|))",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.yukino"
            }
          },
          "end": "\\|",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.yukino"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#strings"
            },
            {
              "name": "keyword.operator.yukino",
              "match": "="
            },
            {
              "name": "punctuation.separator.yukino",
              "match": ","
            },
            {
              "name": "entity.other.attribute-name.cabi.yukino",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.yukino",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#string-interpolation"
            },
            {
              "include": "#string-escapes"
            }
          ]
        },
        {
          "name": "string.quoted.double.yukino",
          "begin": "\"",
          "end": "\"|(?=\\n)",
          "patterns": [
            {
              "include": "#string-interpolation"
            },
            {
              "include": "#string-escapes"
            }
          ]
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.yukino",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.yukino"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.yukino"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.yukino",
          "match": "\\\\(?:[nrt0\\\\\"']|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\})"
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.yukino",
          "match": "'(?:[^'\\\\]|\\\\(?:[nrt0\\\\\"']|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\}))'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.binary.yukino",
          "match": "\\b0b[01]+(_[01]+)*(?:i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        },
        {
          "name": "constant.numeric.hex.yukino",
          "match": "\\b0x[0-9a-fA-F]+(_[0-9a-fA-F]+)*(?:i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        },
        {
          "name": "constant.numeric.octal.yukino",
          "match": "\\b0o[0-7]+(_[0-7]+)*(?:i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        },
        {
          "name": "constant.numeric.float.yukino",
          "match": "\\b[0-9]+(_[0-9]+)*\\.[0-9]+(_[0-9]+)*(?:[eE][+-]?[0-9]+(_[0-9]+)*)?(?:f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.decimal.yukino",
          "match": "\\b[0-9]+(_[0-9]+)*(?:i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)?\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.yukino",
          "match": "\\b(set|rewrite|static|fun|cfun|define|class|struct|cstruct|interface|enum|type|public|locked|operator|externc|get)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.yukino",
          "match": "\\b(if|elif|else|switch|while|for|in|loop|break|continue|return|recur|region|sus|catch|finally|defer|space)\\b"
        }
      ]
    },
    "keywords-other": {
      "patterns": [
        {
          "name": "keyword.other.yukino",
          "match": "\\b(this|super|ref|with|extends|is|as|alias|init)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.yukino",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.yukino",
          "match": "\\b(null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.yukino",
          "match": "\\b(int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64|bool|char|void|never|string|bytes|c_char|c_int|c_size_t|c_void|c_long|c_short|c_uint|usize|isize)\\b"
        },
        {
          "name": "support.type.special.yukino",
          "match": "\\b(ptr|map)\\b"
        },
        {
          "name": "entity.name.type.yukino",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "macro-declarations": {
      "patterns": [
        {
          "match": "\\b(define)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(!)?",
          "captures": {
            "1": {
              "name": "keyword.declaration.yukino"
            },
            "2": {
              "name": "entity.name.function.macro.yukino"
            },
            "3": {
              "name": "keyword.operator.macro.yukino"
            }
          }
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "\\b(fun|cfun)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*<[^>]+>)?",
          "captures": {
            "1": {
              "name": "keyword.declaration.yukino"
            },
            "2": {
              "name": "entity.name.function.yukino"
            }
          }
        }
      ]
    },
    "lambda-expressions": {
      "patterns": [
        {
          "match": "\\b(fun)\\s*(?:<[^>]+>)?\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "keyword.declaration.yukino"
            }
          }
        },
        {
          "match": "(=>)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.fat.yukino"
            }
          }
        }
      ]
    },
    "struct-fields": {
      "patterns": [
        {
          "match": "\\b(?!(?:default|case)\\b)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?![:=])",
          "captures": {
            "1": {
              "name": "variable.other.member.yukino"
            },
            "2": {
              "name": "punctuation.separator.colon.yukino"
            }
          }
        }
      ]
    },
    "imports": {
      "begin": "(?:(public)\\s+)?\\b(load)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.yukino"
        },
        "2": {
          "name": "keyword.control.import.yukino"
        }
      },
      "end": ";|(?=^\\s*(?:fun|cfun|class|struct|cstruct|interface|enum|type|load|public|set|static|rewrite|define)\\b|^\\s*$)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#import-symbols-clause"
        },
        {
          "include": "#import-path"
        }
      ]
    },
    "import-path": {
      "patterns": [
        {
          "name": "punctuation.separator.dot.yukino",
          "match": "\\.\\.\\.|\\.\\.|\\."
        },
        {
          "name": "keyword.operator.folder.yukino",
          "match": "!"
        },
        {
          "name": "keyword.operator.wildcard.yukino",
          "match": "\\*"
        },
        {
          "name": "entity.name.namespace.yukino",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "import-symbols-clause": {
      "begin": ":",
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.colon.yukino"
        }
      },
      "end": ";|(?=^\\s*(?:fun|cfun|class|struct|cstruct|interface|enum|type|load|public|set|static|rewrite|define)\\b|^\\s*$)",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "punctuation.separator.comma.yukino",
          "match": ","
        },
        {
          "name": "keyword.operator.wildcard.yukino",
          "match": "\\*"
        },
        {
          "name": "keyword.other.yukino",
          "match": "\\bas\\b"
        },
        {
          "name": "entity.name.type.yukino",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.yukino",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "macro-calls": {
      "patterns": [
        {
          "match": "\\b(file|line|col|hostenv|get_target|get_yukic_version|yukienv|get_profileconfig|get_features|is_lib_connected|include_str|include_bytes|compile_error|cfg|compile_print)(!)(?=\\s*[\\(\\[\\{])",
          "captures": {
            "1": {
              "name": "support.function.macro.builtin.yukino"
            },
            "2": {
              "name": "keyword.operator.macro.yukino"
            }
          }
        },
        {
          "match": "\\b((?:[a-zA-Z_][a-zA-Z0-9_]*::)*[a-zA-Z_][a-zA-Z0-9_]*)(!)(?=\\s*[\\(\\[\\{])",
          "captures": {
            "1": {
              "name": "entity.name.function.macro.yukino"
            },
            "2": {
              "name": "keyword.operator.macro.yukino"
            }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.yukino"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.null-coalescing.yukino",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.safe-navigation.yukino",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.ternary.yukino",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.arrow.yukino",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.yukino",
          "match": "\\.\\.="
        },
        {
          "name": "keyword.operator.range.yukino",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.double-colon.yukino",
          "match": "::"
        },
        {
          "name": "keyword.operator.comparison.yukino",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.yukino",
          "match": "\\+=|-=|\\*\\*=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|="
        },
        {
          "name": "keyword.operator.arithmetic.yukino",
          "match": "\\*\\*|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.logical.yukino",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.yukino",
          "match": "&|\\||\\^|~|<<|>>"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.yukino",
          "match": ","
        },
        {
          "name": "punctuation.separator.semicolon.yukino",
          "match": ";"
        },
        {
          "name": "punctuation.separator.colon.yukino",
          "match": ":"
        },
        {
          "name": "punctuation.separator.dot.yukino",
          "match": "\\."
        }
      ]
    }
  }
}