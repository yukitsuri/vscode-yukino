{
  "name": "yukino",
  "displayName": "Yukino",
  "description": "Language support for the Yukino programming language.",
  "version": "0.0.1",
  "publisher": "Yukitsuri",
  "author": "Yukitsuri",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:yukino",
    "onLanguage:clarity"
  ],
  "contributes": {
    "languages": [
      {
        "id": "yukino",
        "aliases": [
          "Yukino",
          "yukino"
        ],
        "extensions": [
          ".ykn"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "clarity",
        "aliases": [
          "Clarity",
          "clarity"
        ],
        "extensions": [
          ".cty"
        ],
        "configuration": "./clarity-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yukino",
        "scopeName": "source.yukino",
        "path": "./syntaxes/yukino.tmLanguage.json"
      },
      {
        "language": "clarity",
        "scopeName": "source.clarity",
        "path": "./syntaxes/clarity.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "yukino",
        "path": "./snippets/yukino.json"
      },
      {
        "language": "clarity",
        "path": "./snippets/clarity.json"
      }
    ],
    "commands": [
      {
        "command": "yukino.reindexWorkspace",
        "title": "Yukino: Reindex Workspace Symbols"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
